---
import AppLayout from '../layouts/AppLayout.astro';
import ColumnDiagram from '../components/learning/ColumnDiagram';
import {calculateColumn,type ColumnCalculation} from '../learning/calculator/column-engine';
import type {Operation} from '../learning/calculator/engine';
import '../styles/calculator.css';
const guides:{id:Operation;title:string;first:string;second:string;idea:string;procedure:string[];mistake:string;lesson:string}[]=[
  {id:'add',title:'Penjumlahan bersusun',first:'368',second:'257',idea:'Gabungkan nilai pada tempat yang sama. Sepuluh kelompok pada satu tempat dapat ditukar menjadi satu kelompok di tempat berikutnya.',procedure:['Sejajarkan satuan, puluhan, dan ratusan.','Mulai dari kanan: satuan dahulu, lalu puluhan, lalu ratusan.','Jika jumlah kolom mencapai 10, tulis digit satuannya dan teruskan kelompok puluhan ke kolom kiri. Angka yang “disimpan” memiliki nilai tempat.','Periksa hasil dengan mengurangi kembali salah satu bilangan.'],mistake:'Jangan menulis 15 dalam satu kolom hasil. 15 satuan adalah 1 puluhan dan 5 satuan, bukan dua digit satuan.',lesson:'tambah-puluhan'},
  {id:'subtract',title:'Pengurangan bersusun',first:'1000',second:'278',idea:'Mengurangi mengambil sebagian dari bilangan awal. Pertukaran mengubah bentuk bilangan, tetapi tidak mengubah nilainya.',procedure:['Sejajarkan nilai tempat; bilangan awal pada baris atas.','Mulai dari satuan. Jika digit atas belum cukup, tukar satu kelompok pada tempat di kiri menjadi sepuluh kelompok.','Jika di kiri ada nol, cari kelompok bukan nol dan lakukan pertukaran melalui setiap tempat yang dilalui. Jangan melompati nol.','Kurangi memakai digit setelah pertukaran. Periksa dengan menambahkan kembali bilangan yang dikurangkan.'],mistake:'“Meminjam” bukan mengurangi digit terbesar dengan digit terkecil. Pada 1000, pertukaran menghasilkan 0 ribuan + 9 ratusan + 9 puluhan + 10 satuan; nilainya tetap 1000.',lesson:'kurang-puluhan'},
  {id:'multiply',title:'Perkalian bersusun',first:'123',second:'24',idea:'24 adalah 20 + 4. Kalikan setiap bagian, lalu gabungkan hasilnya: 123 × 24 = 123 × 4 + 123 × 20.',procedure:['Mulai dengan digit satuan pengali; kalikan dari kanan ke kiri.','Tukar setiap 10 hasil unit menjadi satu unit pada tempat berikutnya, seperti pada penjumlahan.','Lanjut ke puluhan pengali. Digit 2 pada 24 bernilai 20, jadi hasil bagian harus mulai di kolom puluhan; satuan diisi nol.','Jumlahkan semua hasil bagian menurut nilai tempat, lalu periksa dengan pembagian.'],mistake:'Baris 123 × 20 adalah 2460, bukan 246. Nol dan posisi baris menyatakan puluhan, bukan aturan menggeser tanpa alasan.',lesson:'perkalian'},
  {id:'divide',title:'Pembagian bersusun',first:'144',second:'12',idea:'Cari banyaknya kelompok pembagi yang muat. Polanya bagi → kalikan → kurangi → turunkan, sambil menjaga nilai sisa.',procedure:['Tulis pembagi di kiri dan bilangan yang dibagi di kanan. Baca bilangan dari kiri sampai pembagi dapat muat.','Tulis digit hasil bagi tepat di atas digit yang sedang dibaca.','Kalikan digit hasil dengan pembagi, lalu kurangi dari bagian yang sedang dibaca.','Turunkan satu digit berikutnya. Jika pembagi tidak muat, tulis 0 pada hasil; jangan menghilangkan tempatnya.','Setelah semua digit dibaca, sisa harus lebih kecil daripada pembagi. Periksa: pembagi × hasil bagi + sisa = bilangan awal.'],mistake:'1005 ÷ 5 menghasilkan 201, bukan 21. Untuk 17 ÷ 4, hasil bagi 4 dengan sisa 1; hasil penuh bukan 4, melainkan 4 + 1/4.',lesson:'pembagian'},
];
const solved=guides.map(g=>{const response=calculateColumn(g.first,g.id,g.second);if(!response.ok)throw new Error(response.message);return {...g,column:response.column as ColumnCalculation};});
---
<AppLayout title="Panduan hitung bersusun" description="Pahami tambah, kurang, kali, dan bagi bersusun melalui nilai tempat, pertukaran, hasil bagian, dan sisa; coba kalkulator langkah demi langkah." learning={true}>
  <article class="column-guide">
    <header class="page-heading"><a class="back-link" href="/kalkulator">← Kalkulator</a><h1>Hitung bersusun, pahami tiap langkah.</h1><p>Bersusun membantu menata digit menurut nilai tempat. Mulai setelah memahami satuan, puluhan, dan pertukaran; tidak harus menjadi cara pertama untuk setiap soal.</p></header>
    <p>Siapkan kartu digit dan ikatan sedotan berisi sepuluh bersama pendamping. Peragakan pertukaran: 10 satuan = 1 puluhan, 10 puluhan = 1 ratusan. Diagram di bawah adalah simbol dari hubungan itu.</p>
    <p><a class="column-guide-link" href="/belajar/nilai-tempat">Nilai tempat dahulu →</a></p>
    <nav aria-label="Pilih operasi bersusun">{solved.map(g=><a href={`#${g.id}`}>{g.id==='add'?'Tambah':g.id==='subtract'?'Kurang':g.id==='multiply'?'Kali':'Bagi'}</a>)}</nav>
    {solved.map(g=><section id={g.id}><h2>{g.title}</h2><p>{g.idea}</p><h3>Tata cara</h3><ol>{g.procedure.map(p=><li>{p}</li>)}</ol><h3>Contoh yang diselesaikan</h3><ColumnDiagram column={g.column} step={g.column.steps.at(-1)!}/><p class="column-step-equation">{g.column.steps.at(-1)!.equation}</p><details><summary>Lihat penjelasan setiap langkah</summary><ol class="calculator__steps">{g.column.steps.map(step=><li><h4>{step.title}</h4><p class="column-step-equation">{step.equation}</p><p>{step.explanation}</p></li>)}</ol></details><p><strong>Perhatikan:</strong> {g.mistake}</p><p><strong>Periksa:</strong> {g.column.check}</p><p><a class="column-guide-link" href="/kalkulator?cara=bersusun">Coba bersusun →</a></p><p><a class="column-guide-link" href={`/belajar/${g.lesson}`}>Latih konsep dahulu →</a></p></section>)}
    <section><h2>Pilih cara yang masuk akal.</h2><p>Untuk 40 + 30, cara mental bisa lebih singkat daripada bersusun. Coba hitung dahulu, perkirakan besar hasilnya, lalu gunakan kalkulator untuk memeriksa dan menceritakan ulang langkahnya.</p><p>Kalkulator bersusun awal memakai bilangan bulat 0–9999; pengali sampai 999 dan pembagi sampai 99. Pengurangan memakai bilangan awal yang tidak lebih kecil. Desimal, negatif, dan hasil pembagian penuh tersedia di Cara biasa. Membaca penyelesaian tidak dicatat sebagai penguasaan.</p></section>
  </article>
</AppLayout>
